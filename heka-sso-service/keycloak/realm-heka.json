{
  "realm": "heka",
  "displayName": "OID4VP SSO Demo",
  "loginTheme": "heka",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": true,
  "registrationEmailAsUsername": false,
  "internationalizationEnabled": false,
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "heka-sso-web-ui",
      "name": "Heka SSO test RP",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "age_over_18",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "age_over_18",
            "claim.name": "age_over_18",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "amr",
            "claim.name": "amr",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "heka-identity-service",
      "name": "Heka Identity Service (resource server)",
      "description": "Bearer-only: never logs in; owns the Heka client roles and is the audience of accepted tokens.",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "heka-identity-web-ui",
      "name": "Heka Identity Service Web UI",
      "description": "Public SPA client: Authorization Code + PKCE, refresh tokens with rotation.",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "rootUrl": "http://localhost:8000",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:8000/*"
      ],
      "webOrigins": [
        "http://localhost:8000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/*",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "heka roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "heka-identity-service",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "heka org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "heka_uid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "heka_uid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "heka audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "heka-identity-service",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "heka-sso-service",
      "name": "Heka SSO Service (service account)",
      "description": "Confidential client used by heka-sso-service to call heka-identity-service via Client Credentials.",
      "enabled": true,
      "publicClient": false,
      "protocol": "openid-connect",
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-heka-sso-service-secret-do-not-use-in-production",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "heka roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "heka-identity-service",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "heka org_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "org_id",
            "claim.name": "org_id",
            "jsonType.label": "String",
            "multivalued": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "heka_uid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "id",
            "claim.name": "heka_uid",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "heka audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "heka-identity-service",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "heka-sso",
      "displayName": "Sign in with wallet",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "clientId": "keycloak-broker",
        "clientSecret": "dev-only-broker-secret-do-not-use-in-production",
        "clientAuthMethod": "client_secret_basic",
        "authorizationUrl": "http://localhost:3005/authorize",
        "tokenUrl": "http://host.docker.internal:3005/token",
        "jwksUrl": "http://host.docker.internal:3005/jwks",
        "userInfoUrl": "http://host.docker.internal:3005/userinfo",
        "logoutUrl": "http://localhost:3005/session/end",
        "issuer": "http://localhost:3005",
        "validateSignature": "true",
        "useJwksUrl": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "defaultScope": "openid",
        "allowedClockSkew": "15",
        "backchannelSupported": "false",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "given_name to firstName",
      "identityProviderAlias": "heka-sso",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "given_name",
        "user.attribute": "firstName",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "family_name to lastName",
      "identityProviderAlias": "heka-sso",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "family_name",
        "user.attribute": "lastName",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "age_over_18",
      "identityProviderAlias": "heka-sso",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "age_over_18",
        "user.attribute": "age_over_18",
        "syncMode": "FORCE"
      }
    },
    {
      "name": "amr",
      "identityProviderAlias": "heka-sso",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "amr",
        "user.attribute": "amr",
        "syncMode": "FORCE"
      }
    }
  ],
  "passwordPolicy": "length(7) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "client": {
      "heka-identity-service": [
        {
          "name": "Admin",
          "description": "Platform administrator: own tenant, full API access (the role the web UI registers with today)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "OrgAdmin",
          "description": "Organization administrator (requires org_id)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "OrgManager",
          "description": "Organization manager (requires org_id)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "OrgMember",
          "description": "Organization member (requires org_id)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "Issuer",
          "description": "Credential issuer inside an organization (requires org_id)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "Verifier",
          "description": "Credential verifier inside an organization (requires org_id)",
          "composite": false,
          "clientRole": true
        },
        {
          "name": "User",
          "description": "Holder / end user: own tenant, no org_id",
          "composite": false,
          "clientRole": true
        }
      ]
    }
  },
  "users": [
    {
      "id": "d3a1c2b4-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
      "username": "demo",
      "enabled": true,
      "emailVerified": false,
      "credentials": [
        {
          "type": "password",
          "value": "Password1234!",
          "temporary": false
        }
      ],
      "groups": [
        "/heka-users"
      ]
    },
    {
      "username": "service-account-heka-sso-service",
      "enabled": true,
      "serviceAccountClientId": "heka-sso-service",
      "clientRoles": {
        "heka-identity-service": [
          "Admin"
        ]
      }
    }
  ],
  "defaultGroups": [
    "/heka-users"
  ],
  "groups": [
    {
      "name": "heka-users",
      "path": "/heka-users",
      "attributes": {},
      "realmRoles": [],
      "clientRoles": {
        "heka-identity-service": [
          "Admin"
        ]
      },
      "subGroups": []
    }
  ]
}
