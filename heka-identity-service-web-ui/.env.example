REACT_APP_AGENCY_ENDPOINT=http://localhost:3000

# OpenID Connect provider that signs users in (Authorization Code + PKCE) and whose tokens
# heka-identity-service accepts. Profile: keycloak (default), auth0 or generic.
REACT_APP_AUTH_PROVIDER=keycloak
REACT_APP_OIDC_AUTHORITY=http://localhost:8080/realms/heka-platform
REACT_APP_OIDC_CLIENT_ID=heka-identity-web-ui
# Optional: scope override (profile default: "openid profile", Auth0 adds offline_access)
# REACT_APP_OIDC_SCOPE=openid profile
# Auth0 only: API identifier, sent as `audience` so the access token is a verifiable JWT
# REACT_APP_OIDC_AUDIENCE=https://heka-identity
# Optional: account page offered as "Change password" by profiles without an in-flow change
# REACT_APP_AUTH_ACCOUNT_URL=

# Demo pages (no sign-in): the demo user's DID and access token, written by scripts/prepare-demo-user.ts
REACT_APP_DEMO_USER_DID=<REACT_APP_DEMO_USER_DID>
REACT_APP_DEMO_USER_ACCESS_TOKEN=<REACT_APP_DEMO_USER_ACCESS_TOKEN>
