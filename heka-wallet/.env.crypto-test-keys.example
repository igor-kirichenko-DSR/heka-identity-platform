# Copy to .env.crypto-test-keys (gitignored). Testnet keys only, never a key that holds real funds.
# Used by the CRYPTO_IT=1 integration tests under packages/crypto/*/__tests__/integration.
# Not read by the app: keep these out of app/.env, because react-native-config compiles that file into the build.

# Base Sepolia (baseSepolia.spec.ts): funded with Base Sepolia ETH and at least 0.01 USDC
CRYPTO_IT_PRIVATE_KEY=

# Hedera testnet (hederaTestnet.spec.ts): funded with at least 5 HBAR. The account is created by a transfer to its
# EVM address (portal faucet); the first send completes it.
CRYPTO_IT_HEDERA_KEY=
# Optional: 1 when the same account holds 0.01+ USDC (0.0.429274), enables the USDC test
CRYPTO_IT_HEDERA_USDC=
# Optional: an account created with maxAutomaticTokenAssociations 0 and a little HBAR, USDC not associated
CRYPTO_IT_HEDERA_RESTRICTED_KEY=
