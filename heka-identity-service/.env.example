IMAGE="heka-identity-service:latest"

# Browser-facing base URL for uploaded logos (web UI, REST responses).
FILE_STORAGE_FS_URL=http://localhost:3000
# Wallet-facing base URL embedded into OID4VCI issuer metadata (`display[].logo.uri`)
# and OCA branding. Wallets reject non-https values, so use the https tunnel — the
# OID4VC router (:3003) also serves the uploaded files (docs/DEPLOYMENT.md). Kept
# separate from FILE_STORAGE_FS_URL because ngrok's free tier answers browsers with
# an interstitial page, which would break <img> tags in the web UI. Defaults to
# FILE_STORAGE_FS_URL. Persisted into issuer records on save — re-save the user
# profile / schemas after changing it.
FILE_STORAGE_FS_PUBLIC_URL=https://<identity-tunnel>.ngrok-free.app

# Public endpoints advertised to wallets and DIDComm peers — see
# docs/DEPLOYMENT.md at the repo root for running behind ngrok.
# Unset variables fall back to http://localhost:<port> (same-host setups only).
#
# OID4VC endpoint (:3003, Credo public router) — wallets fetch credential
# offers (OID4VCI) and presentation requests (OID4VP) here. Third-party
# wallets require https. The URL is baked into offers/requests at creation
# time — recreate QRs after changing it, and restart the service.
# AGENT_OID4VCI_ENDPOINT=https://<your-tunnel>.ngrok-free.app
#
# DIDComm endpoints (:3001 http, :3002 ws) — only needed for DIDComm flows
# with a remote wallet; embedded into DID documents / OOB invitations.
# AGENT_HTTP_ENDPOINT=https://<your-tunnel>.ngrok-free.app
# AGENT_WS_ENDPOINT=wss://<your-tunnel>.ngrok-free.app

# OpenID Connect provider that issues the bearer tokens accepted by the API
# (docs/setup.md#authentication-oidc). Both values are required.
OIDC_ISSUER_URL=http://localhost:8080/realms/heka
OIDC_AUDIENCE=heka-identity-service
#
# Auth0 instead of Keycloak (heka-sso-service/auth0/README.md): the issuer keeps its trailing
# slash, the audience is the API identifier, and the custom claims are namespaced.
# OIDC_ISSUER_URL=https://<tenant>.<region>.auth0.com/
# OIDC_AUDIENCE=https://heka-identity
# OIDC_CLAIM_USER_ID=https://heka/heka_uid
# OIDC_CLAIM_ROLES=https://heka/roles
# OIDC_CLAIM_NAME=https://heka/name,name,nickname
# OIDC_CLAIM_ORG_ID=https://heka/org_id
