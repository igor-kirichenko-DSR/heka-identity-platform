
# Keycloak
REACT_APP_AUTH_PROVIDER=keycloak
REACT_APP_OIDC_AUTHORITY=http://localhost:8080/realms/heka-platform
REACT_APP_OIDC_CLIENT_ID=heka-identity-web-ui
REACT_APP_OIDC_AUDIENCE=
OIDC_ISSUER_URL=http://localhost:8080/realms/heka-platform
OIDC_JWKS_URI=http://host.docker.internal:8080/realms/heka-platform/protocol/openid-connect/certs
OIDC_AUDIENCE=heka-identity-service
OIDC_CLAIM_USER_ID=
OIDC_CLAIM_ROLES=
OIDC_CLAIM_NAME=
OIDC_CLAIM_ORG_ID=
DEMO_TOKEN_URL=http://host.docker.internal:8080/realms/heka-platform/protocol/openid-connect/token
DEMO_CLIENT_ID=heka-demo
DEMO_CLIENT_SECRET=dev-only-heka-demo-secret-do-not-use-in-production
DEMO_TOKEN_PARAMS=
IDENTITY_SERVICE_TOKEN_URL=http://host.docker.internal:8080/realms/heka-platform/protocol/openid-connect/token
IDENTITY_SERVICE_CLIENT_ID=heka-sso-service
IDENTITY_SERVICE_CLIENT_SECRET=dev-only-heka-sso-service-secret-do-not-use-in-production
IDENTITY_SERVICE_TOKEN_PARAMS=

VITE_AUTH_PROVIDER=keycloak
VITE_KC_URL=http://localhost:8080
VITE_KC_REALM=heka
VITE_KC_CLIENT_ID=heka-sso-web-ui
VITE_KC_IDP_HINT=heka-sso
SSO_ISSUER_URL=http://localhost:3005

# Auth0
# REACT_APP_AUTH_PROVIDER=auth0
# REACT_APP_OIDC_AUTHORITY=https://<tenant>.<region>.auth0.com/
# REACT_APP_OIDC_CLIENT_ID=<heka-identity-web-ui SPA client id>
# REACT_APP_OIDC_AUDIENCE=https://heka-identity
# OIDC_ISSUER_URL=https://<tenant>.<region>.auth0.com/
# OIDC_JWKS_URI=
# OIDC_AUDIENCE=https://heka-identity
# OIDC_CLAIM_USER_ID=https://heka/heka_uid
# OIDC_CLAIM_ROLES=https://heka/roles
# OIDC_CLAIM_NAME=https://heka/name,name,nickname
# OIDC_CLAIM_ORG_ID=https://heka/org_id
# DEMO_TOKEN_URL=https://<tenant>.<region>.auth0.com/oauth/token
# DEMO_CLIENT_ID=<heka-demo M2M client id>
# DEMO_CLIENT_SECRET=<heka-demo M2M client secret>
# DEMO_TOKEN_PARAMS={"audience":"https://heka-identity"}
# IDENTITY_SERVICE_TOKEN_URL=https://<tenant>.<region>.auth0.com/oauth/token
# IDENTITY_SERVICE_CLIENT_ID=<heka-sso-service M2M client id>
# IDENTITY_SERVICE_CLIENT_SECRET=<heka-sso-service M2M client secret>
# IDENTITY_SERVICE_TOKEN_PARAMS={"audience":"https://heka-identity"}

# VITE_AUTH_PROVIDER=auth0
# VITE_AUTH0_DOMAIN=<tenant>.<region>.auth0.com
# VITE_AUTH0_CLIENT_ID=<heka-sso-web-ui SPA client id>
# VITE_AUTH0_CONNECTION=heka-sso
# SSO_ISSUER_URL=https://<ngrok host for 3005>

